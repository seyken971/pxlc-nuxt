---
interface Props {
  count?: number
  accentAt?: number
  class?: string
}
const { count = 14, accentAt = 11, class: className } = Astro.props
const cells = Array.from({ length: count }, (_, i) => i)
---

<span class:list={['pixel-strip', className]} aria-hidden="true">
  {cells.map(i => <span class:list={[{ 'is-accent': i === accentAt }]}></span>)}
</span>
