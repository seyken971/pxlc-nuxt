---
import type { HTMLAttributes } from 'astro/types'

interface Props {
  id: string
  label: string
  type?: HTMLAttributes<'input'>['type']
  placeholder?: string
  rows?: number
  required?: boolean
  autocomplete?: string
}
const { id, label, type, placeholder, rows, required, autocomplete } = Astro.props
---

<div>
  <label for={id} class="form-label">{label}{required && <span class="form-label__req" aria-hidden="true">*</span>}</label>
  {rows
    ? (
        <textarea
          id={id}
          rows={rows}
          placeholder={placeholder}
          required={required}
          aria-required={required ? 'true' : undefined}
          class="form-textarea"></textarea>
      )
    : (
        <input
          id={id}
          type={type ?? 'text'}
          placeholder={placeholder}
          required={required}
          aria-required={required ? 'true' : undefined}
          autocomplete={autocomplete}
          class="form-input"
        />
      )}
</div>
