---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteBreadcrumb from '../../components/SiteBreadcrumb.astro'
import BlogToc from '../../components/BlogToc.astro'
import BlogShare from '../../components/BlogShare.astro'
import BlogCta from '../../components/BlogCta.astro'
import BlogRelated from '../../components/BlogRelated.astro'
import { fmtDate } from '../../lib/date-format'
import andyPortrait from '../../assets/photos/andy-portrait.jpg'

export async function getStaticPaths() {
  const posts = await getCollection('blog', p => !p.data.draft)
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }))
}

interface Props {
  post: CollectionEntry<'blog'>
}
const { post } = Astro.props
const data = post.data

const { Content, headings } = await render(post)

const articlePath = `/blog/${post.id}`
const articleUrl = `https://pxlc.fr${articlePath}/`

// Sommaire : entrées h2 (parité avec l'ancien useArticleBody qui marchait
// l'AST @nuxt/content). Les slugs viennent du même algorithme github-slugger.
const toc = headings.filter(h => h.depth === 2).map(h => ({ id: h.slug, label: h.text }))

// Temps de lecture : valeur manuelle du frontmatter (tous les articles en ont
// une) ; repli défensif à 200 mots/min sur le corps markdown brut.
const readingTime = data.readingTime
  || `${Math.max(1, Math.round((post.body ?? '').split(/\s+/).filter(Boolean).length / 200))} min`

const seo = {
  // seoTitle/seoDescription : variantes courtes anti-troncature (limites
  // dans scripts/seo-limits.mjs) ; le title/description éditorial reste
  // le H1 et le lead.
  title: data.seoTitle || data.title,
  description: data.seoDescription || data.description,
  ogType: 'article' as const,
  // Strip the "· PXLC" titleTemplate suffix from OG cards — og:site_name already
  // carries the brand; the full title alone can exceed the ~60-char social limit.
  ogTitle: data.title,
  ogImage: `https://pxlc.fr/_og/blog/${post.id}.png`,
}
---

<BaseLayout {...seo}>
  <article>

    <!-- Reading progress bar — coral line fixed at viewport top -->
    <div class="reading-bar" aria-hidden="true">
      <div class="reading-bar__fill" id="reading-bar-fill"></div>
    </div>

    <!-- Article header — bg-soft section per DS -->
    <section class="article-intro">
      <div class="container article-intro__inner">
        <SiteBreadcrumb currentLabel={data.title} />

        <header class="post-header">
          <span class="badge">{data.category}</span>
          <h1 class="post-title">
            {data.title}<span class="coral-dot" aria-hidden="true">.</span>
          </h1>
          <p class="lead post-lead">{data.description}</p>
          <div class="post-meta">
            <time datetime={data.date}>{fmtDate(data.date)}</time>
            {readingTime && <span>· {readingTime} de lecture</span>}
            {data.updated && data.updated !== data.date && (
              <span>· mis à jour le <time datetime={data.updated}>{fmtDate(data.updated)}</time></span>
            )}
          </div>
          <!-- Author card — per DS BlogArticle -->
          <div class="post-author">
            <div class="post-author__avatar">
              <Image
                src={andyPortrait}
                alt="Andy Zébus"
                width={48}
                height={48}
                format="webp"
              />
            </div>
            <div>
              <div class="post-author__name">Andy Zébus</div>
              <div class="post-author__role">Médiateur numérique · PXLC · Guadeloupe</div>
            </div>
          </div>
        </header>
      </div>
    </section>

    <!-- Article body -->
    <section class="article-body">
      <div class="container post-container">
        {data.cover && (
          <figure class="post-cover">
            <img src={data.cover} alt={data.coverAlt || data.title} loading="eager" fetchpriority="high" />
          </figure>
        )}

        <BlogToc entries={toc} />

        <div class="prose post-body">
          <Content />
        </div>

        <BlogShare class="post-share" url={articleUrl} title={data.title} />

        <BlogCta />
      </div>
    </section>

    <!-- Related articles — full-width bg-soft section, rendered by component -->
    <BlogRelated currentPath={articlePath} currentCategory={data.category} />

  </article>
</BaseLayout>

<script>
  // Reading progress — coral bar fixed at top of viewport, per DS. rAF-throttled.
  const fill = document.getElementById('reading-bar-fill')
  let progressRaf = 0
  const onReadingScroll = () => {
    if (progressRaf) return
    progressRaf = requestAnimationFrame(() => {
      const docH = document.documentElement.scrollHeight - window.innerHeight
      const pct = docH > 0 ? Math.min(100, Math.round((window.scrollY / docH) * 100)) : 0
      if (fill) fill.style.transform = `scaleX(${pct / 100})`
      progressRaf = 0
    })
  }
  onReadingScroll()
  window.addEventListener('scroll', onReadingScroll, { passive: true })
</script>

<style>
  /* ── Reading progress bar ─────────────────────────────────────── */
  .reading-bar {
    position: fixed; top: 0; left: 0; right: 0; z-index: var(--z-progress);
    height: 3px; background: transparent; pointer-events: none;
  }
  .reading-bar__fill {
    height: 100%; width: 100%; background: var(--pxlc-coral);
    transform-origin: left; transform: scaleX(0);
    transition: transform 80ms linear;
  }

  /* ── Article header (bg-soft section) ───────────────────────── */
  .article-intro {
    background: var(--bg-soft);
    border-bottom: 1px solid var(--bg-rule);
    padding: clamp(32px, 4vw, 56px) 0;
    transition: background var(--dur-base);
  }
  .article-intro__inner { max-width: 800px; }

  /* ── Article body ────────────────────────────────────────────── */
  .article-body { padding: clamp(40px, 6vw, 72px) 0; }
  .post-container { max-width: 680px; }

  /* ── Post header ─────────────────────────────────────────────── */
  .post-header { margin-bottom: 0; }
  .post-title {
    font-size: clamp(34px, 5vw, 52px);
    letter-spacing: -0.025em; line-height: 1.1;
    margin: var(--space-3) 0 var(--space-4);
    text-wrap: balance;
  }
  .post-lead { margin-bottom: var(--space-4); }
  .post-meta {
    font-family: var(--font-label); font-size: 11px;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--quiet);
    display: flex; flex-wrap: wrap; gap: var(--space-2);
  }

  /* ── Author card ─────────────────────────────────────────────── */
  .post-author {
    display: flex; align-items: center; gap: var(--space-3);
    margin-top: var(--space-4); padding-top: var(--space-4);
    border-top: 1px solid var(--bg-rule);
  }
  .post-author__avatar {
    width: 48px; height: 48px; border-radius: 50%;
    overflow: hidden; flex-shrink: 0; border: 2px solid var(--rule);
  }
  .post-author__avatar :global(img) {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .post-author__name {
    font-family: var(--font-display); font-weight: 600; font-size: 15px;
    color: var(--ink); margin-bottom: var(--space-1);
  }
  .post-author__role {
    font-family: var(--font-label); font-size: 11px;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--quiet);
  }

  /* ── Cover + body ────────────────────────────────────────────── */
  .post-cover {
    margin: 0 0 32px; border-radius: var(--radius-lg); overflow: hidden;
  }
  .post-cover :global(img) { width: 100%; height: auto; display: block; }
  .post-body { font-size: 16px; line-height: 1.7; }
  /* Sticky header offset géré globalement par html { scroll-padding-top: 96px } dans styles.css. */
  .post-body :global(h2[id]) { scroll-margin-top: 0; }
  .post-container :global(.post-share) { margin-top: var(--space-6); padding-top: var(--space-5); border-top: 1px solid var(--rule); }
</style>
