---
import { createHash } from 'node:crypto'
import '../styles/fonts.css'
import '../styles/styles.css'
import { SITE } from '../config/site'
import { THEME_SCRIPT } from '../lib/theme-script'
import SiteHeader from '../components/SiteHeader.astro'
import SiteMobileMenu from '../components/SiteMobileMenu.astro'
import SiteFooter from '../components/SiteFooter.astro'
import CtaBlock from '../components/CtaBlock.astro'

interface Props {
  /** Titre de page sans suffixe — le layout applique « %s · PXLC ». ≤ 53 caractères. */
  title: string
  /** Meta description. ≤ 120 caractères. */
  description: string
  /** og:description si différente de description (ex : accueil). */
  ogDescription?: string
  /** og:title si différent du titre complet — les articles retirent le
      suffixe « · PXLC » (og:site_name porte déjà la marque). */
  ogTitle?: string
  ogType?: 'website' | 'article'
  robots?: string
  /** URL absolue de l'image OG (1200×600). */
  ogImage?: string
  /** Pages sans CTA global : contact (déjà saturée de CTA) et mentions légales. */
  hideGlobalCta?: boolean
  /** Graphe schema.org complet de la page (nœuds du @graph). */
  schemaGraph?: Record<string, unknown>[]
}

const {
  title,
  description,
  ogDescription = description,
  ogType = 'website',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  ogImage = `${SITE.url}/og/site.png`,
  hideGlobalCta = false,
  schemaGraph,
} = Astro.props

const fullTitle = `${title}${SITE.titleSuffix}`
const { ogTitle = fullTitle } = Astro.props
const canonical = new URL(Astro.url.pathname, SITE.url).href

// La CSP est émise par Astro (security.csp dans astro.config.mjs), qui hache
// lui-même les scripts et styles qu'il traite. Le JSON-LD est un script inline
// propre à chaque page : on le sérialise une fois, on déclare son hash, puis on
// rend cette même chaîne — hash et contenu servi restent identiques.
const jsonLd = schemaGraph
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schemaGraph })
  : null
if (jsonLd) {
  Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(jsonLd, 'utf8').digest('base64')}`)
}
---

<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Anti-flash : pose data-theme avant le premier paint pour que le rendu
         initial respecte la préférence stockée / système. Inline synchrone. -->
    <script is:inline set:html={THEME_SCRIPT} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={SITE.author} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#082B36" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#EAF6F4" media="(prefers-color-scheme: light)" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="600" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:creator" content={SITE.twitter} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:src" content={ogImage} />
    <meta name="twitter:image:width" content="1200" />
    <meta name="twitter:image:height" content="600" />
    <link rel="alternate" type="application/rss+xml" title={`Blog ${SITE.name}`} href="/rss.xml" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <SiteHeader />
    <SiteMobileMenu />
    <!-- tabindex="-1" makes <main> a valid focus target so the skip link
         actually moves focus (and screen-reader virtual cursor) into the
         page content instead of just scrolling past the header. -->
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!hideGlobalCta && <CtaBlock />}
    <SiteFooter />

    <script>
      // Scroll reveal — ajoute .is-visible aux éléments animés quand ils
      // entrent dans le viewport. MPA : s'exécute à chaque chargement de page.
      // Ignoré si prefers-reduced-motion (le CSS rend alors tout visible).
      const TARGETS
        = '.animate-in:not(.is-visible), .card--method:not(.is-visible), .blog-card:not(.is-visible)'

      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        const scrollIO = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible')
                scrollIO.unobserve(e.target)
              }
            })
          },
          { threshold: 0.08 },
        )
        document.querySelectorAll(TARGETS).forEach(el => scrollIO.observe(el))
      }
    </script>
  </body>
</html>
