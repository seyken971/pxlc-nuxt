{
  "permissions": {
    "allow": [
      "PowerShell(npm run a11y:runtime 2>&1)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "PowerShell(git add docs/)",
      "Bash(node -e ' *)",
      "Bash(python -c ' *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py .claude/hooks/post-edit-checks.py",
            "timeout": 90,
            "statusMessage": "Vérifications post-édition (astro sync / ESLint)…"
          }
        ]
      }
    ]
  }
}
