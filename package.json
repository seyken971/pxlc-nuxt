{
  "name": "pxlc-nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "gen:tokens": "node scripts/generate-tokens.mjs",
    "design": "node scripts/export-design.mjs",
    "ds-lint": "node scripts/ds-lint.mjs",
    "validate-content": "node scripts/validate-content.mjs",
    "prebuild": "npm run gen:tokens && npm run design && npm run ds-lint && npm run validate-content",
    "pregenerate": "npm run gen:tokens && npm run design && npm run ds-lint && npm run validate-content",
    "predev": "npm run gen:tokens && npm run design",
    "postbuild": "node scripts/prune-public.mjs",
    "postgenerate": "node scripts/prune-public.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "a11y:runtime": "node scripts/a11y-runtime.mjs",
    "lighthouse": "node scripts/lighthouse-audit.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:ce": "vite build --config vite.ce.config.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vue": "^7.0.2",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/simple-icons": "^1.2.93",
    "@nuxt/content": "^3.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.0",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/seo": "^5.3.12",
    "@resvg/resvg-js": "^2.6.2",
    "@takumi-rs/core": "^2.7.2",
    "astro": "^7.2.2",
    "astro-icon": "^1.1.5",
    "better-sqlite3": "^12.11.1",
    "nuxt": "^4.5.2",
    "puppeteer": "^25.6.0",
    "satori": "^0.29.0",
    "vue": "^3.5.41",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@nuxt/eslint": "^1.17.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "axe-core": "^4.13.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.0",
    "nuxt-link-checker": "^5.1.2",
    "nuxt-security": "^2.6.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.9"
  }
